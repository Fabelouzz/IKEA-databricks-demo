    {
      "name": "Frankfurter - GET FX Rates (Date Range)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.frankfurter.app/2024-01-01..2024-01-10?from=EUR&to=SEK,USD",
          "protocol": "https",
          "host": ["api", "frankfurter", "app"],
          "path": ["2024-01-01..2024-01-10"],
