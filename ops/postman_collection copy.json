  },
  "item": [
    {
      "name": "DummyJSON - GET Products (Pagination)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/products?limit=10&skip=0",
          "protocol": "https",
          "host": ["dummyjson", "com"],
          "path": ["products"],
          "query": [
            {
              "key": "limit",
              "value": "10",
              "description": "Number of products per page"
            },
            {
              "key": "skip",
              "value": "0",
              "description": "Number of products to skip (offset)"
            }
          ]
        },
        "description": "Fetch products with pagination using limit and skip parameters. Demonstrates GET request with query parameters for pagination."
      },
      "response": []
    },
    {
      "name": "DummyJSON - GET Products Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/products/search?q=phone&limit=10&skip=0",
          "protocol": "https",
          "host": ["dummyjson", "com"],
          "path": ["products", "search"],
          "query": [
            {
              "key": "q",
              "value": "phone",
              "description": "Search term"
            },
            {
              "key": "limit",
              "value": "10",
              "description": "Number of results to return"
            },
            {
              "key": "skip",
              "value": "0",
              "description": "Number of results to skip (pagination)"
            }
          ]
        },
        "description": "Search products using GET with query parameters. Returns products matching the search term with pagination support."
      },
      "response": []
    },
